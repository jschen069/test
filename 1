    trainer.experiment_name="${exp_name}" \
    trainer.n_gpus_per_node=16 \
    trainer.nnodes=1 \
    trainer.default_local_dir=/home/chenjiansheng/qwen3vl_verl_0130 \
    trainer.resume_mode=auto \
        trainer.validation_data_dir=/home/chenjiansheng/outputs \
