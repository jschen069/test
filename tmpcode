        # dump generations as JSONL (always save)
        val_data_dir = self.config.trainer.get("validation_data_dir", None) or os.path.join(
            self.config.trainer.default_local_dir, "val_predictions"
        )
        self._dump_generations(
            inputs=sample_inputs,
            outputs=sample_outputs,
            gts=sample_gts,
            scores=sample_scores,
            reward_extra_infos_dict=reward_extra_infos_dict,
            dump_path=val_data_dir,
        )
